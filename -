-- 1. Создание базы данных
CREATE DATABASE StudentLibrary;
GO
USE StudentLibrary;
GO

-- 2. Создание таблицы студентов
CREATE TABLE Students (
    StudentID INT IDENTITY(1,1) PRIMARY KEY,
    FirstName NVARCHAR(50) NOT NULL,
    LastName NVARCHAR(50) NOT NULL,
    BirthDate DATE,
    Email NVARCHAR(100) UNIQUE,
    PhoneNumber NVARCHAR(20)
);

-- 3. Создание таблицы книг
CREATE TABLE Books (
    BookID INT IDENTITY(1,1) PRIMARY KEY,
    Title NVARCHAR(255) NOT NULL,
    Author NVARCHAR(255) NOT NULL,
    Genre NVARCHAR(100),
    PublishedYear INT,
    ISBN NVARCHAR(20) UNIQUE
);

-- 4. Создание таблицы выдачи книг
CREATE TABLE BookLoans (
    LoanID INT IDENTITY(1,1) PRIMARY KEY,
    StudentID INT NOT NULL,
    BookID INT NOT NULL,
    LoanDate DATE NOT NULL DEFAULT GETDATE(),
    ReturnDate DATE NULL,
    CONSTRAINT FK_BookLoans_Students FOREIGN KEY (StudentID) REFERENCES Students(StudentID) ON DELETE CASCADE,
    CONSTRAINT FK_BookLoans_Books FOREIGN KEY (BookID) REFERENCES Books(BookID) ON DELETE CASCADE
);
