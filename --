// Гостиница "Маяк" - Полная ERD схема

Table Residents {
  resident_id INT [pk]
  full_name VARCHAR(100)
  contact_details VARCHAR(100)
  identity_document VARCHAR(50)
  preferences TEXT
  loyalty_status VARCHAR(20)
}

Table ChamberTypes {
  type_id INT [pk]
  type_name VARCHAR(50)
  max_occupancy INT
  amenities TEXT
  base_rate DECIMAL(10,2)
  size_sqm INT
}

Table ChamberStates {
  state_id INT [pk]
  state_name VARCHAR(20)
  state_description TEXT
}

Table Chambers {
  chamber_id INT [pk]
  chamber_number VARCHAR(10)
  floor_level INT
  category_type INT [ref: > ChamberTypes.type_id]
  current_state INT [ref: > ChamberStates.state_id]
}

Table Reservations {
  reservation_id INT [pk]
  resident_ref INT [ref: > Residents.resident_id]
  chamber_ref INT [ref: > Chambers.chamber_id]
  expected_arrival TIMESTAMP
  planned_departure TIMESTAMP
  reservation_status VARCHAR(20)
  special_requests TEXT
}

Table Stays {
  stay_id INT [pk]
  reservation_ref INT [ref: > Reservations.reservation_id]
  actual_check_in TIMESTAMP
  actual_check_out TIMESTAMP
  stay_rating INT
  incident_reports TEXT
}

Table AccessKeys {
  key_id INT [pk]
  resident_ref INT [ref: > Residents.resident_id]
  chamber_ref INT [ref: > Chambers.chamber_id]
  key_issued TIMESTAMP
  key_expires TIMESTAMP
  key_status VARCHAR(20)
  key_type VARCHAR(20)
}

Table Personnel {
  employee_id INT [pk]
  employee_name VARCHAR(100)
  position VARCHAR(50)
  contact_info VARCHAR(100)
  work_schedule TEXT
  access_level VARCHAR(30)
}

Table Amenities {
  service_id INT [pk]
  service_name VARCHAR(50)
  service_category VARCHAR(30)
  price DECIMAL(10,2)
  availability BOOLEAN
}

Table ServiceOrders {
  order_id INT [pk]
  service_ref INT [ref: > Amenities.service_id]
  stay_ref INT [ref: > Stays.stay_id]
  order_time TIMESTAMP
  fulfillment_status VARCHAR(20)
  charged_amount DECIMAL(10,2)
}

Table Transactions {
  transaction_id INT [pk]
  stay_ref INT [ref: > Stays.stay_id]
  amount DECIMAL(10,2)
  payment_date TIMESTAMP
  payment_method VARCHAR(30)
  invoice_number VARCHAR(50)
  transaction_status VARCHAR(20)
}

Table Sanitation {
  task_id INT [pk]
  chamber_ref INT [ref: > Chambers.chamber_id]
  assigned_to INT [ref: > Personnel.employee_id]
  scheduled_time TIMESTAMP
  completion_time TIMESTAMP
  inspection_notes TEXT
  cleaning_supplies TEXT
}
  scheduled_time
  completion_time
  inspection_notes
  cleaning_supplies
}
